# Copy to .env.local. These are public contract ids (NEXT_PUBLIC_*), not secrets.
NEXT_PUBLIC_NETWORK_ID=testnet
NEXT_PUBLIC_RPC_URL=https://test.rpc.fastnear.com
NEXT_PUBLIC_EXPLORER_URL=https://testnet.nearblocks.io
NEXT_PUBLIC_FACTORY_ID=gaballs.testnet
NEXT_PUBLIC_NFT_ID=nft.gaballs.testnet
NEXT_PUBLIC_USDT_ID=usdt.gaballs.testnet

# Optional, local development only: sign as a test account using its key from ~/.near-credentials.
# Works only with `next dev`; production builds contain no dev-signer code (checked after every build).
# DEV_SIGNER=1
# DEV_SIGNER_ACCOUNT=buyer1.gaballs.testnet

# Privy (Google/email login). Public app id from dashboard.privy.io.
NEXT_PUBLIC_PRIVY_APP_ID=
